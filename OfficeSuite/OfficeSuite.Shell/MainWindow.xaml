<Window x:Class="OfficeSuite.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource OfficeWindowStyle}">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewWordDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}"/>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ReplaceCommand}"/>
        <KeyBinding Key="F11" Command="{Binding FullScreenCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Style="{StaticResource OfficeMenuStyle}">
            <MenuItem Header="_File" Style="{StaticResource OfficeMenuItemStyle}">
                <MenuItem Header="_New">
                    <MenuItem Header="_Word Document" Command="{Binding NewWordDocumentCommand}" InputGestureText="Ctrl+N"/>
                    <MenuItem Header="_Spreadsheet" Command="{Binding NewSpreadsheetCommand}"/>
                    <MenuItem Header="_Presentation" Command="{Binding NewPresentationCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="_Print..." Command="{Binding PrintCommand}" InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit" Style="{StaticResource OfficeMenuItemStyle}">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header "_Select All" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A"/>
                <Separator/>
                <MenuItem Header="_Find..." Command="{Binding FindCommand}" InputGestureText="Ctrl+F"/>
                <MenuItem Header="_Replace..." Command="{Binding ReplaceCommand}" InputGestureText="Ctrl+H"/>
            </MenuItem>
            <MenuItem Header="_View" Style="{StaticResource OfficeMenuItemStyle}">
                <MenuItem Header="_Zoom">
                    <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++"/>
                    <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-"/>
                    <MenuItem Header="_Normal Size" InputGestureText="Ctrl+0"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Full Screen" Command="{Binding FullScreenCommand}" InputGestureText="F11"/>
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource OfficeMenuItemStyle}">
                <MenuItem Header="_About Office Suite" Command="{Binding AboutCommand}"/>
                <MenuItem Header="_Options..." Command="{Binding OptionsCommand}"/>
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1" Background="#F3F3F3">
            <ToolBar Style="{StaticResource OfficeToolBarStyle}" Band="0" BandIndex="0">
                <Button Command="{Binding NewWordDocumentCommand}" ToolTip="New Document">
                    <TextBlock Text="New"/>
                </Button>
                <Button Command="{Binding OpenCommand}" ToolTip="Open">
                    <TextBlock Text="Open"/>
                </Button>
                <Button Command="{Binding SaveCommand}" ToolTip="Save">
                    <TextBlock Text="Save"/>
                </Button>
                <Separator/>
                <Button Command="{Binding UndoCommand}" ToolTip="Undo">
                    <TextBlock Text="Undo"/>
                </Button>
                <Button Command="{Binding RedoCommand}" ToolTip="Redo">
                    <TextBlock Text="Redo"/>
                </Button>
                <Separator/>
                <Button Command="{Binding CutCommand}" ToolTip="Cut">
                    <TextBlock Text="Cut"/>
                </Button>
                <Button Command="{Binding CopyCommand}" ToolTip="Copy">
                    <TextBlock Text="Copy"/>
                </Button>
                <Button Command="{Binding PasteCommand}" ToolTip="Paste">
                    <TextBlock Text="Paste"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#DADADA" BorderThickness="0,0,1,0" Width="200"
                    Visibility="{Binding IsDocumentOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Documents" FontWeight="SemiBold" Padding="8" Background="#E5E5E5"/>

                    <ListBox Grid.Row="1" Style="{StaticResource OfficeListBoxStyle}">
                        <ListBoxItem Style="{StaticResource OfficeListBoxItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Word Document" Margin="0,0,8,0"/>
                                <TextBlock Text=".docx" Foreground="Gray"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource OfficeListBoxItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Spreadsheet" Margin="0,0,8,0"/>
                                <TextBlock Text=".xlsx" Foreground="Gray"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource OfficeListBoxItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Presentation" Margin="0,0,8,0"/>
                                <TextBlock Text=".pptx" Foreground="Gray"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <TabControl Grid.Column="1" Style="{StaticResource OfficeTabControlStyle}"
                        Visibility="{Binding IsDocumentOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem Header="Document" Style="{StaticResource OfficeTabItemStyle}">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Margin="8,4">
                                <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="150" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Calibri" IsSelected="True"/>
                                    <ComboBoxItem Content="Arial"/>
                                    <ComboBoxItem Content="Times New Roman"/>
                                    <ComboBoxItem Content="Consolas"/>
                                </ComboBox>
                                <TextBlock Text="Size:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="60" Margin="0,0,8,0">
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="11" IsSelected="True"/>
                                    <ComboBoxItem Content="12"/>
                                    <ComboBoxItem Content="14"/>
                                    <ComboBoxItem Content="16"/>
                                    <ComboBoxItem Content="18"/>
                                    <ComboBoxItem Content="24"/>
                                    <ComboBoxItem Content="36"/>
                                </ComboBox>
                                <Button Content="B" FontWeight="Bold" Width="24" Margin="2,0" ToolTip="Bold"/>
                                <Button Content="I" FontStyle="Italic" Width="24" Margin="2,0" ToolTip="Italic"/>
                                <Button Content="U" Width="24" Margin="2,0" ToolTip="Underline"/>
                                <Separator Margin="4,0"/>
                                <Button Content="Left" Width="40" Margin="2,0" ToolTip="Align Left"/>
                                <Button Content="Center" Width="50" Margin="2,0" ToolTip="Align Center"/>
                                <Button Content="Right" Width="40" Margin="2,0" ToolTip="Align Right"/>
                            </StackPanel>
                        </Border>

                        <RichTextBox Grid.Row="1" x:Name="DocumentEditor" Padding="20"
                                     BorderThickness="0" FontFamily="Calibri" FontSize="11"
                                     AcceptsTab="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto">
                            <FlowDocument>
                                <Paragraph>
                                    <Run Text="Welcome to Office Suite"/>
                                </Paragraph>
                                <Paragraph>
                                    <Run Text="Start typing your document here..."/>
                                </Paragraph>
                            </FlowDocument>
                        </RichTextBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Column="2" Background="#F3F3F3" BorderBrush="#DADADA" BorderThickness="1,0,0,0" Width="150"
                    Visibility="{Binding IsDocumentOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Properties" FontWeight="SemiBold" Padding="8" Background="#E5E5E5"/>

                    <StackPanel Grid.Row="1" Margin="8">
                        <TextBlock Text="Document Properties" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Author:" Margin="0,4,0,2"/>
                        <TextBox Style="{StaticResource OfficeTextBoxStyle}" Text="User"/>
                        <TextBlock Text="Title:" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource OfficeTextBoxStyle}" Text="Document"/>
                        <TextBlock Text="Subject:" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource OfficeTextBoxStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="{Binding IsDocumentOpen, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Office Suite" FontSize="32" FontWeight="Light" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Create or open a document to get started" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource OfficeButtonStyle}" Width="180" Height="120" Margin="10"
                                Command="{Binding NewWordDocumentCommand}">
                            <StackPanel>
                                <TextBlock Text="Word" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Document" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OfficeButtonStyle}" Width="180" Height="120" Margin="10"
                                Command="{Binding NewSpreadsheetCommand}">
                            <StackPanel>
                                <TextBlock Text="Excel" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Spreadsheet" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OfficeButtonStyle}" Width="180" Height="120" Margin="10"
                                Command="{Binding NewPresentationCommand}">
                            <StackPanel>
                                <TextBlock Text="PowerPoint" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Presentation" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Recent Documents" FontWeight="SemiBold" FontSize="14" Margin="0,40,0,10" HorizontalAlignment="Center"/>
                    <ListBox Width="400" Height="150" Style="{StaticResource OfficeListBoxStyle}">
                        <ListBoxItem Style="{StaticResource OfficeListBoxItemStyle}">
                            <TextBlock Text="No recent documents"/>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Style="{StaticResource OfficeStatusBarStyle}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ready" Margin="0,0,20,0"/>
                    <TextBlock Text="100%" Margin="0,0,10,0"/>
                    <TextBlock Text="English (US)"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
