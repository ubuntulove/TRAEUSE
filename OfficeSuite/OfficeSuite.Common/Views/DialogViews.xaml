                <Button x:Name="NoButton"
                        Content="No"
                        Style="{StaticResource MessageBoxButtonStyle}"
                        Visibility="Collapsed"
                        Click="NoButton_Click"/>
                <Button x:Name="RetryButton"
                        Content="Retry"
