<Window x:Class="IndoorSceneEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="室内物品 3D 场景编辑器 — indoor-scene/v1"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" x:Key="PaletteBtn">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="新建" Click="NewScene_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="打开..." Click="OpenScene_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="保存" Click="SaveScene_Click" Style="{StaticResource ToolBtn}"/>
                <Button Content="另存为..." Click="SaveAsScene_Click" Style="{StaticResource ToolBtn}"/>
                <Separator Margin="6,2"/>
                <Button Content="导入示例" Click="LoadSample_Click" Style="{StaticResource ToolBtn}"/>
                <Separator Margin="6,2"/>
                <TextBlock Text="场景：" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="SceneNameBox" Width="220" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪 — 鼠标拖动旋转视角，滚轮缩放"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 主体：左物品面板 | 中3D视图 | 右属性面板 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左：物品面板 -->
            <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <TextBlock Text="添加物品" FontWeight="Bold" Margin="2,4"/>
                        <WrapPanel>
                            <Button Content="沙发"   Click="AddItem_Click" Tag="Sofa"   Style="{StaticResource PaletteBtn}"/>
                            <Button Content="桌子"   Click="AddItem_Click" Tag="Table"  Style="{StaticResource PaletteBtn}"/>
                            <Button Content="椅子"   Click="AddItem_Click" Tag="Chair"  Style="{StaticResource PaletteBtn}"/>
                            <Button Content="床"     Click="AddItem_Click" Tag="Bed"    Style="{StaticResource PaletteBtn}"/>
                            <Button Content="柜子"   Click="AddItem_Click" Tag="Cabinet" Style="{StaticResource PaletteBtn}"/>
                            <Button Content="落地灯" Click="AddItem_Click" Tag="Lamp"   Style="{StaticResource PaletteBtn}"/>
                            <Button Content="盆栽"   Click="AddItem_Click" Tag="Plant"  Style="{StaticResource PaletteBtn}"/>
                            <Button Content="电视"   Click="AddItem_Click" Tag="TV"     Style="{StaticResource PaletteBtn}"/>
                            <Button Content="书架"   Click="AddItem_Click" Tag="Shelf"  Style="{StaticResource PaletteBtn}"/>
                            <Button Content="地毯"   Click="AddItem_Click" Tag="Rug"    Style="{StaticResource PaletteBtn}"/>
                        </WrapPanel>

                        <TextBlock Text="选中物品操作" FontWeight="Bold" Margin="2,12,2,4"/>
                        <Button Content="删除选中" Click="DeleteSelected_Click" Style="{StaticResource ToolBtn}" HorizontalAlignment="Stretch"/>
                        <Button Content="复制选中" Click="DuplicateSelected_Click" Style="{StaticResource ToolBtn}" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中：3D 视图 -->
            <Border Grid.Column="1" Background="#1E1E1E">
                <Viewport3D x:Name="Viewport"
                            MouseDown="Viewport_MouseDown"
                            MouseMove="Viewport_MouseMove"
                            MouseUp="Viewport_MouseUp"
                            MouseWheel="Viewport_MouseWheel"/>
            </Border>

            <!-- 右：物品列表 + 属性 -->
            <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 物品列表 -->
                    <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="场景物品" FontWeight="Bold" Margin="6,6"/>
                            <ListBox x:Name="ItemList" Margin="6,0,6,6"
                                     SelectionChanged="ItemList_SelectionChanged"/>
                        </DockPanel>
                    </Border>

                    <!-- 属性面板 -->
                    <Border Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8" x:Name="PropsPanel">
                                <TextBlock Text="属性" FontWeight="Bold" Margin="0,0,0,6"/>

                                <TextBlock Text="名称"/>
                                <TextBox x:Name="PropName" Margin="0,0,0,6"/>

                                <TextBlock Text="类型（交换）"/>
                                <ComboBox x:Name="PropType" Margin="0,0,0,6"
                                          SelectionChanged="PropType_SelectionChanged"/>

                                <TextBlock Text="颜色"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBox x:Name="PropColor" Width="100"/>
                                    <Button Content="选色..." Click="PickColor_Click" Margin="4,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="位置 X"/>
                                <TextBox x:Name="PropX" Margin="0,0,0,6"/>
                                <TextBlock Text="位置 Z"/>
                                <TextBox x:Name="PropZ" Margin="0,0,0,6"/>

                                <TextBlock Text="旋转 Y (度)"/>
                                <TextBox x:Name="PropRot" Margin="0,0,0,6"/>

                                <TextBlock Text="缩放"/>
                                <TextBox x:Name="PropScale" Margin="0,0,0,6"/>

                                <Button Content="应用" Click="ApplyProps_Click"
                                        Margin="0,8,0,0" Padding="8,4"/>

                                <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="#666"
                                           Margin="0,12,0,0"
                                           Text="提示：修改数值后点击「应用」。可随时在「类型」下拉中交换为其他家具，位置与样式保持不变。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
